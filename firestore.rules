rules_version = '2';

// ===============================================================
// ARSIGEN GastroPOS · Production Firestore Security Rules
// Document Reference: ARS-SPEC-BRP-004 (v1.2.0) & ARS-SPEC-DBS-003 (v1.2.0)
// Plantilla Base: "Bistró & Leña · Fuego Sagrado"
// Architecture: Closed Software with Google Auth Whitelist
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions & Whitelist Validation
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function getUserEmail() {
      return request.auth.token.email;
    }

    function hasStaffDoc() {
      return isAuthenticated() &&
             getUserEmail() != null &&
             exists(/databases/$(database)/documents/authorized_staff/$(getUserEmail()));
    }

    function getStaffData() {
      return get(/databases/$(database)/documents/authorized_staff/$(getUserEmail())).data;
    }

    // Un usuario es staff válido si su correo existe en authorized_staff y active == true
    function isStaff() {
      return isDeveloper() || (hasStaffDoc() && getStaffData().active == true);
    }

    // Desarrollador maestro de ARSIGEN (Josué Caro)
    function isDeveloper() {
      return isAuthenticated() && (
        getUserEmail() == 'caro11josue@gmail.com' ||
        request.auth.token.role == 'developer' ||
        (hasStaffDoc() && getStaffData().role == 'developer')
      );
    }

    // Administrador del restaurante (o Desarrollador)
    function isAdmin() {
      return isDeveloper() || (isStaff() && getStaffData().role == 'admin');
    }

    // Mesero de salón
    function isWaiter() {
      return isStaff() && getStaffData().role == 'waiter';
    }

    // ===============================================================
    // 1. Configuración General (/config/general)
    // ===============================================================
    match /config/{docId} {
      // Lectura pública: Necesaria para renderizar la carta digital al comensal
      allow read: if true;
      // Solo el Administrador o Desarrollador pueden editar configuración
      allow write: if isAdmin() || isDeveloper();
    }

    // ===============================================================
    // 2. Categorías del Menú (/categories)
    // ===============================================================
    match /categories/{categoryId} {
      // Lectura pública: El comensal consulta las categorías
      allow read: if true;
      // Escritura: Solo el Administrador o Desarrollador
      allow write: if isAdmin();
    }

    // ===============================================================
    // 3. Catálogo de Productos (/menu_items)
    // ===============================================================
    match /menu_items/{itemId} {
      // Lectura pública: El comensal consulta la carta
      allow read: if true;
      // Escritura: Solo el Administrador o Desarrollador (precios, fotos, pausa de stock)
      allow write: if isAdmin();
    }

    // ===============================================================
    // 4. Catálogo de Mesas (/tables - Plan Business)
    // ===============================================================
    match /tables/{tableId} {
      // Solo el personal autorizado (meseros y admin) puede ver y operar mesas
      allow read: if isStaff();
      
      // Actualizaciones operativas:
      // - Admin puede cambiar cualquier mesa
      // - Mesero puede cambiar de vacia a sin_imprimir o mantenerla ocupada
      allow update: if isStaff() && (
        isAdmin() ||
        (isWaiter() && (
          request.resource.data.status != 'vacia' || resource.data.status == 'vacia'
        ))
      );

      // Alta y baja física de mesas: Solo Administrador
      allow create, delete: if isAdmin();
    }

    // ===============================================================
    // 5. Órdenes y Comandas (/orders - Plan Business)
    // ===============================================================
    match /orders/{orderId} {
      // Solo el personal operativo puede consultar las órdenes activas
      allow read: if isStaff();

      // Creación: Permitida a meseros o administradores activos
      allow create: if isStaff() && (
        request.resource.data.status == 'sin_imprimir' &&
        request.resource.data.items.size() > 0
      );

      // Actualización:
      // REGLA FUNDAMENTAL DE INMUTABILIDAD:
      // Si la orden ya está 'pagada', NINGÚN usuario puede modificarla.
      allow update: if isStaff() && (
        resource.data.status != 'pagada' && (
          isAdmin() ||
          (isWaiter() && (
            resource.data.status != 'cancelada' &&
            request.resource.data.status != 'pagada' &&
            request.resource.data.status != 'cancelada'
          ))
        )
      );

      // PROHIBICIÓN TOTAL DE BORRADO FÍSICO:
      // Las órdenes jamás se eliminan de la base de datos (auditoría fiscal inmutable).
      allow delete: if false;
    }

    // ===============================================================
    // 6. Whitelist de Personal Autorizado (/authorized_staff)
    // ===============================================================
    match /authorized_staff/{email} {
      // Cada usuario autenticado puede leer su propio registro para verificar su rol
      // El Administrador y Desarrollador pueden leer toda la lista
      allow read: if isAuthenticated() && (
        getUserEmail() == email ||
        isAdmin()
      );

      // Creación y actualización de personal:
      // El Desarrollador puede gestionar cualquier rol.
      // El Administrador SOLO puede crear y actualizar meseros (role == 'waiter').
      allow create, update: if isDeveloper() || (
        isAdmin() && request.resource.data.role == 'waiter'
      );

      // Eliminación de personal:
      // El Desarrollador puede eliminar cualquier personal.
      // El Administrador SOLO puede eliminar meseros (role == 'waiter').
      allow delete: if isDeveloper() || (
        isAdmin() && resource.data.role == 'waiter'
      );
    }

    // Compatibilidad legado con colección /users si existiera
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
